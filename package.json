{
  "name": "unimais-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,yellow,magenta \"npm run dev -w @hub/api\" \"npm run worker -w @hub/api\" \"npm run dev -w @hub/web\"",
    "build": "npm run build -w @hub/api && npm run build -w @hub/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:local": "tsx scripts/db-local.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @hub/db",
    "db:migrate": "npm run migrate -w @hub/db",
    "db:seed": "npm run seed -w @hub/db",
    "db:check": "npm run check -w @hub/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
