# Copie para .env (nunca faça commit do .env).

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

# Endereço da interface (links dos e-mails e checagem de origem contra CSRF).
# Fora de produção, a API também aceita localhost e IPs da rede local (192.168..., 10...).
APP_URL=http://localhost:5173
# Em produção (HTTPS): true.
COOKIE_SECURE=false

# API em runtime: papel hub_app (não é dono das tabelas e não ignora RLS).
DATABASE_URL=postgres://hub_app:hub_app@localhost:5432/unimais_hub
# Migrations e seed: dono do schema.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/unimais_hub

# Porta do Postgres embutido (npm run db:local). Mantenha igual à das URLs acima.
PGPORT=5432

# Administradores gerais (perfil admin, veem todos os departamentos), separados por vírgula.
# O npm run db:migrate cria ou promove essas contas; sem senha local, entram pelo Google.
ADMIN_EMAILS=

# HTTPS no Vite com o certificado do `npm run cert:dev`. Use para abrir pela rede com login do
# Google: o Google não aceita IP, mas aceita https://<ip-com-traços>.nip.io:5173 (o script mostra).
DEV_HTTPS=false

# Login com Google: crie um "ID do cliente OAuth" (Aplicativo da Web) no Google Cloud Console e
# cadastre lá o GOOGLE_REDIRECT_URI exatamente igual. O Google não aceita IP de rede local:
# localmente use http://localhost:5173/...; em produção, o domínio com HTTPS.
# Sem ID e segredo, o botão "Entrar com Google" não aparece. Só entra quem já está cadastrado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Domínios aceitos (vazio = qualquer conta Google cadastrada no sistema).
GOOGLE_ALLOWED_DOMAINS=facmais.edu.br

# Testes de integração (o banco de teste é recriado a cada execução).
TEST_DATABASE_URL=postgres://hub_app:hub_app@localhost:5432/unimais_hub_test
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/unimais_hub_test

# E-mail: "log" escreve no console (desenvolvimento); "smtp" envia de verdade.
EMAIL_TRANSPORT=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=UniMais Hub <nao-responda@unimais.edu.br>

# Imagens enviadas (prints colados). Em produção, uma pasta fora do código, com backup.
UPLOAD_DIR=.local/uploads

# Abrir chamado por e-mail (opcional): caixas IMAP monitoradas pelo worker, uma por departamento.
# INBOUND_MAILBOXES=[{"acronym":"TI","host":"imap.unimais.edu.br","port":993,"user":"ti@unimais.edu.br","password":"..."}]
INBOUND_MAILBOXES=[]
