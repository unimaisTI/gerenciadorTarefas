# Copie para .env (nunca faça commit do .env).

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

# Endereço da interface (links dos e-mails e checagem de origem contra CSRF).
APP_URL=http://localhost:5173
# Em produção (HTTPS): true.
COOKIE_SECURE=false

# API em runtime: papel hub_app (não é dono das tabelas e não ignora RLS).
DATABASE_URL=postgres://hub_app:hub_app@localhost:5432/unimais_hub
# Migrations e seed: dono do schema.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/unimais_hub

# Testes de integração (o banco de teste é recriado a cada execução).
TEST_DATABASE_URL=postgres://hub_app:hub_app@localhost:5432/unimais_hub_test
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/unimais_hub_test

# E-mail: "log" escreve no console (desenvolvimento); "smtp" envia de verdade.
EMAIL_TRANSPORT=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=UniMais Hub <nao-responda@unimais.edu.br>

# Imagens enviadas (prints colados). Em produção, uma pasta fora do código, com backup.
UPLOAD_DIR=.local/uploads

# Abrir chamado por e-mail (opcional): caixas IMAP monitoradas pelo worker, uma por departamento.
# INBOUND_MAILBOXES=[{"acronym":"TI","host":"imap.unimais.edu.br","port":993,"user":"ti@unimais.edu.br","password":"..."}]
INBOUND_MAILBOXES=[]
